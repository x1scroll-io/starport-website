{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "starportwallet.app" }], "destination": "https://starportwallet.com/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "starportwallet.net" }], "destination": "https://starportwallet.com/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "starportwallet.xyz" }], "destination": "https://starportwallet.com/$1", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|svg|png|jpg|webp|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
